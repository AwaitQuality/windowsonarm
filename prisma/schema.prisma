generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
  // Required on Cloudflare: workerd forbids runtime Wasm compilation, so the
  // client must be generated against the workerd runtime instead.
  runtime  = "cloudflare"
}

datasource db {
  provider = "sqlite"
}

model Post {
  id                    String       @id @default(uuid())
  categoryId            String
  title                 String
  company               String
  user_id               String?
  status_id             Int          @map("status")
  status_hint           Int?
  // Always written on create and by every recompute. Kept non-null because the
  // public listing filters `{ not: PENDING_STATUS_ID }` and in SQL
  // `NOT (NULL = -1)` is NULL, which would silently hide the row.
  effective_status_id   Int          @map("effective_status")
  community_voted       Boolean      @default(false)
  description           String
  tags                  Tag[]
  app_url               String?
  community_url         String?
  banner_url            String?
  icon_url              String?
  discord_forum_post_id String?
  created_at            DateTime     @default(now())
  updated_at            DateTime     @default(now())
  update_description    String?
  category              Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  status                Status       @relation("PostStatus", fields: [status_id], references: [id])
  // Restrict, not SetNull: deleting a Status must not silently unpublish every
  // post that pointed at it.
  effective_status      Status       @relation("PostEffectiveStatus", fields: [effective_status_id], references: [id], onDelete: Restrict)
  upvotes               Upvote[]
  reviews               Review[]
  status_votes          StatusVote[]
  views                 View[]
  upvotes_count         Int          @default(0)
  views_count           Int          @default(0)

  @@index([status_id])
  @@index([user_id])
  @@index([created_at])
  @@index([upvotes_count])
  @@index([views_count])
  // Hot listing path: filter on effective_status, order by one of the counters.
  @@index([effective_status_id, upvotes_count, views_count])
  // Category filter combined with the public-visibility filter.
  @@index([categoryId, effective_status_id])
}

model Tag {
  id    String @id @default(uuid())
  index Int    @default(0) @map("idx")
  name  String @unique
  posts Post[]

  @@index([name])
}

model Upvote {
  id      Int    @id @default(autoincrement())
  user_id String
  post_id String
  Post    Post   @relation(fields: [post_id], references: [id], onDelete: Cascade)

  // One upvote per user per post: the toggle route relies on this to stay
  // idempotent under concurrent requests, and upvotes_count drives public
  // ordering.
  @@unique([post_id, user_id])
  @@index([user_id])
}

model Status {
  id              Int          @id @default(autoincrement())
  index           Int          @default(0) @map("idx")
  name            String       @unique
  color           String
  text            String
  icon            String
  posts           Post[]       @relation("PostStatus")
  effective_posts Post[]       @relation("PostEffectiveStatus")
  StatusVote      StatusVote[]

  @@index([name])
}

model Category {
  id    String @id @default(uuid())
  index Int    @default(0) @map("idx")
  name  String @unique
  icon  String
  posts Post[]

  @@index([name])
}

model Review {
  id         String   @id @default(uuid())
  post_id    String
  user_id    String
  rating     Int // 1-5 stars
  comment    String? // Optional review text
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
  post       Post     @relation(fields: [post_id], references: [id], onDelete: Cascade)

  // One review per user per post, so averageRating cannot be skewed by a
  // double-submit race.
  @@unique([post_id, user_id])
  @@index([user_id])
}

model StatusVote {
  id         String   @id @default(uuid())
  post_id    String
  user_id    String
  status_id  Int
  created_at DateTime @default(now())
  post       Post     @relation(fields: [post_id], references: [id], onDelete: Cascade)
  status     Status   @relation(fields: [status_id], references: [id])

  @@unique([post_id, user_id])
  @@index([user_id])
  @@index([status_id])
}

model View {
  id      String @id @default(uuid())
  post_id String
  /// Keyed (HMAC-SHA256) digest of the visitor IP, never the plaintext. Only
  /// used to deduplicate views via the composite unique below.
  ip_hash String
  created_at DateTime @default(now())
  post       Post     @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@unique([post_id, ip_hash])
}

/// An admin-issued bearer credential for the public API. The token itself is
/// never stored — only its SHA-256 digest — so a database leak cannot be
/// replayed against the API.
model ApiKey {
  id      String @id @default(uuid())
  /// Clerk user id of the admin who owns the key. Every authenticated request
  /// re-checks that this user still holds the admin role, so demoting an admin
  /// disables their keys without a separate revocation step.
  user_id String
  name    String
  /// Public half of the token. Unique so a presented token resolves to exactly
  /// one row with a single indexed lookup, before any digest comparison.
  prefix  String @unique
  /// SHA-256 of the full token, lower-case hex.
  hash    String
  /// JSON-encoded array of ApiScope values. SQLite has no array type, and the
  /// set is small enough that querying inside it is never needed.
  scopes  String

  last_used_at DateTime?
  expires_at   DateTime?
  /// Set instead of deleting the row, so an audit of which key acted stays
  /// possible after revocation.
  revoked_at   DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@index([user_id])
  @@index([user_id, revoked_at])
}

model BlogPost {
  id          String   @id @default(uuid())
  title       String
  content     String
  description String? // Add this field for short preview
  image_url   String?
  published   Boolean  @default(true)
  author_id   String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([author_id])
  @@index([created_at])
  // Blog index: published posts ordered by date.
  @@index([published, created_at])
}
