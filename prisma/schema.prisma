generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
  // Required on Cloudflare: workerd forbids runtime Wasm compilation, so the
  // client must be generated against the workerd runtime instead.
  runtime  = "cloudflare"
}

datasource db {
  provider = "sqlite"
}

model Post {
  id                    String       @id @default(uuid())
  categoryId            String
  title                 String
  company               String
  user_id               String?
  status_id             Int          @map("status")
  status_hint           Int?
  effective_status_id   Int?         @map("effective_status")
  community_voted       Boolean      @default(false)
  description           String
  tags                  Tag[]
  app_url               String?
  community_url         String?
  banner_url            String?
  icon_url              String?
  discord_forum_post_id String?
  created_at            DateTime     @default(now())
  updated_at            DateTime     @default(now())
  update_description    String?
  category              Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  status                Status       @relation("PostStatus", fields: [status_id], references: [id])
  effective_status      Status?      @relation("PostEffectiveStatus", fields: [effective_status_id], references: [id])
  upvotes               Upvote[]
  reviews               Review[]
  status_votes          StatusVote[]
  views                 View[]
  upvotes_count         Int          @default(0)
  views_count           Int          @default(0)

  @@index([categoryId])
  @@index([status_id])
  @@index([effective_status_id])
  @@index([user_id])
  @@index([created_at])
  @@index([upvotes_count])
  @@index([views_count])
}

model Tag {
  id    String @id @default(uuid())
  index Int    @default(0) @map("idx")
  name  String @unique
  posts Post[]

  @@index([name])
}

model Upvote {
  id      Int     @id @default(autoincrement())
  user_id String?
  post_id String?
  Post    Post?   @relation(fields: [post_id], references: [id])

  @@index([user_id])
  @@index([post_id])
}

model Status {
  id              Int          @id @default(autoincrement())
  index           Int          @default(0) @map("idx")
  name            String       @unique
  color           String
  text            String
  icon            String
  posts           Post[]       @relation("PostStatus")
  effective_posts Post[]       @relation("PostEffectiveStatus")
  StatusVote      StatusVote[]

  @@index([name])
}

model Category {
  id    String @id @default(uuid())
  index Int    @default(0) @map("idx")
  name  String @unique
  icon  String
  posts Post[]

  @@index([name])
}

model Review {
  id         String   @id @default(uuid())
  post_id    String
  user_id    String
  rating     Int // 1-5 stars
  comment    String? // Optional review text
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
  post       Post     @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@index([post_id])
  @@index([user_id])
}

model StatusVote {
  id         String   @id @default(uuid())
  post_id    String
  user_id    String
  status_id  Int
  created_at DateTime @default(now())
  post       Post     @relation(fields: [post_id], references: [id], onDelete: Cascade)
  status     Status   @relation(fields: [status_id], references: [id])

  @@unique([post_id, user_id])
  @@index([post_id])
  @@index([user_id])
  @@index([status_id])
}

model View {
  id         String   @id @default(uuid())
  post_id    String
  ip_address String
  created_at DateTime @default(now())
  post       Post     @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@unique([post_id, ip_address])
  @@index([post_id])
  @@index([ip_address])
}

model BlogPost {
  id          String   @id @default(uuid())
  title       String
  content     String
  description String? // Add this field for short preview
  image_url   String?
  published   Boolean  @default(true)
  author_id   String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([author_id])
  @@index([created_at])
}
