# Production build-time values. NEXT_PUBLIC_* variables are inlined into the
# client bundle at build time, so a Worker secret cannot supply them — building
# without this file bakes the pk_test_ key from .env/.dev.vars into production
# and signs out every real user.
#
# A Clerk publishable key is public by design (it is visible in the shipped
# bundle), so it belongs in git. The secret key does not: that is a Worker secret.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsud2luZG93c29uYXJtLm9yZyQ
